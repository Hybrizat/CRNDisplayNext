# ==========================================
# CRN Display Native Extended — .gitignore
# NeoForge 1.21.1 ModDevGradle project
# ==========================================

# ── Gradle ────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!**/src/**/build/

# ── IDE: IntelliJ IDEA ────────────────────
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/**/out/

# ── IDE: Eclipse ──────────────────────────
.apt_generated
.classpath
.eclipse/
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/**/bin/

# ── IDE: VS Code ──────────────────────────
.vscode/

# ── Local mod dependencies ────────────────
# local-maven/ holds pinned Modrinth Forge builds downloaded by the installModrinthDeps task.
local-maven/
# libs/ contains the CRN, Create, Ponder JARs needed for compilation.
# These are copyrighted third-party files and must NOT be committed.
# Other developers must obtain them from their own game installations.
libs/

# ── NeoForge / Minecraft run artifacts ────
# Generated by ./gradlew runClient / runServer
run/
runs/
!**/src/**/run/
**/src/generated/**/.cache/
repo/
!**/src/**/repo/

# ── Mixin refmap (generated at build time) ─
src/main/resources/*.refmap.json

# ── OS generated files ────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Java ──────────────────────────────────
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar


.run/
# scratch dir (local probes/extracts)
.tmp/
